<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Reading which app comes to the foreground (granted by the user in "Usage access"). -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <!-- Opening the interruption screen from the background, over the flagged app ("Display over other apps"). -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Lists the launchable apps without the QUERY_ALL_PACKAGES permission. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- Recognizes the phone's home screen (Android 11+ limits the visible apps). -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
    </queries>

    <!--
        allowBackup=false already turns off any backup; dataExtractionRules (Android 12+) and localeConfig (Android 13+)
        are simply ignored on older versions.
    -->
    <application
        tools:ignore="DataExtractionRules,UnusedAttribute"
        android:name=".ConscienceApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Conscience">

        <activity
            android:name=".ui.home.HomeActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.apps.MainActivity"
            android:exported="false" />

        <activity
            android:name=".ui.onboarding.OnboardingActivity"
            android:exported="false" />

        <activity
            android:name=".ui.onboarding.OnboardingProblemsActivity"
            android:exported="false" />

        <activity
            android:name=".ui.onboarding.OnboardingAppsActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.onboarding.OnboardingAppListActivity"
            android:exported="false" />

        <activity
            android:name=".ui.onboarding.OnboardingAppDetailActivity"
            android:exported="false" />

        <activity
            android:name=".ui.onboarding.OnboardingPermissionActivity"
            android:exported="false" />

        <activity
            android:name=".ui.problems.ProblemDetailActivity"
            android:exported="false" />

        <activity
            android:name=".ui.problems.ProblemsManagerActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.stats.StatsActivity"
            android:exported="false" />

        <activity
            android:name=".ui.stats.AppStatsActivity"
            android:exported="false" />

        <activity
            android:name=".ui.settings.SettingsActivity"
            android:exported="false" />

        <activity
            android:name=".ui.settings.FaqActivity"
            android:exported="false" />

        <activity
            android:name=".ui.about.AboutActivity"
            android:exported="false" />

        <activity
            android:name=".ui.apps.AppDetailActivity"
            android:exported="false" />

        <activity
            android:name=".ui.interruption.InterstitialActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:taskAffinity=""
            android:theme="@style/Theme.Conscience.Interstitial" />

        <!-- Watches which app comes to the foreground (Usage access) and shows the interruption screen over a flagged one. -->
        <service
            android:name=".service.FrictionMonitorService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Detects which app comes to the foreground (Usage access permission) to show a reminder screen before the user opens an app they flagged for ethical issues. Only package names are read; nothing is stored or sent." />
        </service>

        <receiver
            android:name=".service.FrictionBootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
