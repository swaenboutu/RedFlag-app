<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permet de lister les apps lançables sans la permission QUERY_ALL_PACKAGES. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- Reconnaître l'écran d'accueil du téléphone (Android 11+ limite les apps visibles). -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
    </queries>

    <!--
        allowBackup=false coupe déjà toute sauvegarde ; dataExtractionRules (Android 12+) et localeConfig (Android 13+)
        sont simplement ignorés sur les versions plus anciennes.
    -->
    <application
        tools:ignore="DataExtractionRules,UnusedAttribute"
        android:name=".ConscienceApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Conscience">

        <activity
            android:name=".ui.home.HomeActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.apps.MainActivity"
            android:exported="false" />

        <activity
            android:name=".ui.onboarding.OnboardingActivity"
            android:exported="false" />

        <activity
            android:name=".ui.onboarding.OnboardingProblemsActivity"
            android:exported="false" />

        <activity
            android:name=".ui.onboarding.OnboardingAppsActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.onboarding.OnboardingAppListActivity"
            android:exported="false" />

        <activity
            android:name=".ui.onboarding.OnboardingAppDetailActivity"
            android:exported="false" />

        <activity
            android:name=".ui.onboarding.OnboardingPermissionActivity"
            android:exported="false" />

        <activity
            android:name=".ui.problems.ProblemDetailActivity"
            android:exported="false" />

        <activity
            android:name=".ui.apps.AppPickerActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.problems.ProblemsManagerActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.stats.StatsActivity"
            android:exported="false" />

        <activity
            android:name=".ui.stats.AppStatsActivity"
            android:exported="false" />

        <activity
            android:name=".ui.settings.SettingsActivity"
            android:exported="false" />

        <activity
            android:name=".ui.settings.FaqActivity"
            android:exported="false" />

        <activity
            android:name=".ui.apps.AppDetailActivity"
            android:exported="false" />

        <activity
            android:name=".ui.interruption.InterstitialActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:taskAffinity=""
            android:theme="@style/Theme.Conscience.Interstitial" />

        <service
            android:name=".service.FrictionAccessibilityService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>
    </application>
</manifest>
