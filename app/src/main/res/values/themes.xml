<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Brand colors (cream, navy ink, coral accents), light or dark with the phone: every color goes through the tokens of colors.xml. -->
    <style name="Theme.Conscience" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary_fill</item>
        <item name="colorOnPrimary">@color/on_primary_fill</item>
        <item name="colorSecondaryContainer">@color/secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/ink</item>
        <item name="android:colorBackground">@color/app_background</item>
        <!-- Explicites : avant Android 9/10 (sans affichage bord à bord), sinon fond noir et barres bleu nuit. -->
        <item name="android:windowBackground">@color/app_background</item>
        <item name="android:statusBarColor">@color/app_background</item>
        <item name="android:navigationBarColor">@color/surface_warm</item>
        <item name="android:windowLightStatusBar">@bool/light_bars</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">@bool/light_bars</item>
        <item name="colorSurface">@color/surface_warm</item>
        <item name="colorOnSurface">@color/ink</item>
        <item name="colorSurfaceVariant">@color/surface_variant</item>
        <item name="colorSurfaceContainerLowest">@color/surface_warm</item>
        <item name="colorSurfaceContainerLow">@color/surface_warm</item>
        <item name="colorSurfaceContainer">@color/surface_warm</item>
        <item name="colorSurfaceContainerHigh">@color/surface_warm</item>
        <item name="colorSurfaceContainerHighest">@color/surface_warm</item>
        <item name="colorOutline">@color/outline</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.Conscience.MaterialAlertDialog</item>
        <item name="colorOnSurfaceVariant">@color/ink_secondary</item>
        <item name="colorOutlineVariant">@color/line</item>

        <item name="android:fontFamily">@font/inter</item>
        <item name="fontFamily">@font/inter</item>

        <item name="textAppearanceDisplayLarge">@style/TextAppearance.Conscience.DisplayLarge</item>
        <item name="textAppearanceDisplayMedium">@style/TextAppearance.Conscience.DisplayMedium</item>
        <item name="textAppearanceDisplaySmall">@style/TextAppearance.Conscience.DisplaySmall</item>
        <item name="textAppearanceHeadlineLarge">@style/TextAppearance.Conscience.HeadlineLarge</item>
        <item name="textAppearanceHeadlineMedium">@style/TextAppearance.Conscience.HeadlineMedium</item>
        <item name="textAppearanceHeadlineSmall">@style/TextAppearance.Conscience.HeadlineSmall</item>
        <item name="textAppearanceTitleLarge">@style/TextAppearance.Conscience.TitleLarge</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.Conscience.TitleMedium</item>
        <item name="textAppearanceTitleSmall">@style/TextAppearance.Conscience.TitleSmall</item>
        <item name="textAppearanceBodyLarge">@style/TextAppearance.Conscience.BodyLarge</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.Conscience.BodyMedium</item>
        <item name="textAppearanceBodySmall">@style/TextAppearance.Conscience.BodySmall</item>
        <item name="textAppearanceLabelLarge">@style/TextAppearance.Conscience.LabelLarge</item>
        <item name="textAppearanceLabelMedium">@style/TextAppearance.Conscience.LabelMedium</item>
        <item name="textAppearanceLabelSmall">@style/TextAppearance.Conscience.LabelSmall</item>
    </style>

    <!-- Dialogs: our surface color instead of Material's default tint, rounded like the cards. -->
    <style name="ThemeOverlay.Conscience.MaterialAlertDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorSurfaceContainerHigh">@color/dialog_surface</item>
        <item name="colorSurface">@color/dialog_surface</item>
        <item name="dialogCornerRadius">28dp</item>
    </style>

    <!-- Interruption screen: follows the phone's light/dark mode (colors in values and values-night). -->
    <style name="Theme.Conscience.Interstitial" parent="Theme.Conscience">
        <item name="android:windowBackground">@color/interruption_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">@bool/interruption_light_bars</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">@bool/interruption_light_bars</item>
    </style>

    <!-- Écran Réglages -->
    <style name="Widget.Conscience.Switch" parent="Widget.Material3.CompoundButton.MaterialSwitch">
        <item name="thumbIcon">@null</item>
        <item name="thumbTint">@color/interstitial_text</item>
        <item name="trackTint">@color/switch_track</item>
        <item name="trackDecorationTint">@android:color/transparent</item>
    </style>
    <style name="Widget.Conscience.SettingsSection" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">20dp</item>
        <item name="android:layout_marginTop">24dp</item>
        <item name="android:layout_marginEnd">20dp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:fontFamily">@font/inter_semibold</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
        <item name="android:textSize">14sp</item>
    </style>
    <style name="Widget.Conscience.SettingsCard" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">12dp</item>
        <item name="android:layout_marginEnd">12dp</item>
        <item name="android:background">@drawable/bg_card_white</item>
        <item name="android:orientation">vertical</item>
    </style>
    <style name="Widget.Conscience.SettingsDivider" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:layout_marginStart">16dp</item>
        <item name="android:layout_marginEnd">16dp</item>
        <item name="android:background">?attr/colorOutlineVariant</item>
        <item name="android:importantForAccessibility">no</item>
    </style>

    <!-- Filtres de la liste des applications -->
    <style name="Widget.Conscience.SegmentItem" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:background">@drawable/bg_segment_item</item>
        <item name="android:fontFamily">@font/inter_semibold</item>
        <item name="android:gravity">center</item>
        <item name="android:minWidth">56dp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:textColor">@color/segment_text</item>
        <item name="android:textSize">16sp</item>
    </style>
    <style name="Widget.Conscience.FilterChip" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">30dp</item>
        <item name="android:background">@drawable/bg_filter_chip</item>
        <item name="android:fontFamily">@font/inter_medium</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingHorizontal">12dp</item>
        <item name="android:textColor">@color/filter_chip_text</item>
        <item name="android:textSize">12sp</item>
    </style>

    <!-- Légende d'un graphique : une pastille colorée (drawableTint) et son libellé -->

    <!-- Barre de navigation du bas -->
    <style name="Widget.Conscience.NavIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/nav_indicator</item>
    </style>
    <style name="TextAppearance.Conscience.NavActive" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">12sp</item>
    </style>
    <style name="TextAppearance.Conscience.NavInactive" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:fontFamily">@font/inter_medium</item>
        <item name="android:textSize">12sp</item>
    </style>
</resources>
