    <!-- The tags are real HTML (escaped): the texts go through HtmlCompat, see OnboardingPermissionActivity. -->
    <string name="onboarding_permission_intro">To know when you open a flagged app, %1$s needs Android’s &lt;b&gt;accessibility service&lt;/b&gt;.</string>
    <string name="onboarding_permission_step1">Tap “%1$s”: Android’s settings open.</string>
    <string name="onboarding_permission_step2">In the list of apps, find &lt;b&gt;%1$s&lt;/b&gt;.</string>
    <string name="onboarding_permission_step3">Open it and choose to &lt;b&gt;turn it on&lt;/b&gt;, then confirm.</string>
    <string name="onboarding_permission_sample_state">Off</string>
    <string name="onboarding_permission_note1">%1$s only looks at &lt;b&gt;which app is launched&lt;/b&gt;.</string>
    <string name="onboarding_permission_note2">It does not read or collect anything you do on your phone, and nothing leaves it.</string>
    <string name="onboarding_permission_note3">You can withdraw this permission at any time in Android’s settings.</string>
    <string name="onboarding_permission_body">To warn you before you open an app you have flagged, %1$s needs Android\'s accessibility service. It only detects the name of the app coming to the foreground: no screen content is read and no data leaves your device.\n\nIn the settings that open, find “%1$s” and turn it on.</string>
