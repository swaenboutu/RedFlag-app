<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="32dp"
    android:paddingEnd="20dp"
    android:paddingBottom="20dp">

    <include
        android:id="@+id/topbar"
        layout="@layout/view_onboarding_topbar" />

    <app.redflag.ui.common.HeadingTextView
        style="@style/Widget.Conscience.ScreenTitle.Hero"
        android:layout_width="match_parent"
        android:layout_marginTop="20dp"
        android:text="@string/onboarding_problems_title"
        app:lineHeight="38dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:includeFontPadding="false"
        android:text="@string/onboarding_problems_body"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="16sp"
        app:lineHeight="24dp" />
</LinearLayout>
