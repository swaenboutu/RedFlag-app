<?xml version="1.0" encoding="utf-8"?>
<!-- Barre de navigation commune aux écrans principaux : Applications, Problématiques, Statistiques, Réglages. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?attr/colorOutlineVariant"
        android:importantForAccessibility="no" />

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurface"
        app:elevation="0dp"
        android:minHeight="64dp"
        app:itemPaddingBottom="6dp"
        app:itemPaddingTop="6dp"
        app:itemActiveIndicatorStyle="@style/Widget.Conscience.NavIndicator"
        app:itemIconTint="@color/nav_icon_tint"
        app:itemTextAppearanceActive="@style/TextAppearance.Conscience.NavActive"
        app:itemTextAppearanceInactive="@style/TextAppearance.Conscience.NavInactive"
        app:itemTextColor="@color/nav_label_tint"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/bottom_nav" />
</LinearLayout>
