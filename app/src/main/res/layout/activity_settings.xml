<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingTop="12dp"
        android:paddingEnd="20dp">

        <ImageButton
            android:id="@+id/back"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/back"
            android:src="@drawable/ic_arrow_back"
            app:tint="?attr/colorOnSurface" />

        <app.redflag.ui.common.HeadingTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:fontFamily="@font/bricolage_grotesque"
            android:includeFontPadding="false"
            android:text="@string/settings_title"
            android:textColor="?attr/colorOnSurface"
            android:textSize="26sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Interruption -->
            <app.redflag.ui.common.HeadingTextView
                style="@style/Widget.Conscience.SettingsSection"
                android:text="@string/settings_section_interruption" />

            <LinearLayout
                android:id="@+id/cardInterruption"
                style="@style/Widget.Conscience.SettingsCard">

                <include
                    android:id="@+id/rowPause"
                    layout="@layout/item_setting_row" />
            </LinearLayout>

            <!-- Display -->
            <app.redflag.ui.common.HeadingTextView
                style="@style/Widget.Conscience.SettingsSection"
                android:text="@string/settings_section_display" />

            <LinearLayout
                android:id="@+id/cardDisplay"
                style="@style/Widget.Conscience.SettingsCard">

                <include
                    android:id="@+id/rowAppearance"
                    layout="@layout/item_setting_row" />
            </LinearLayout>

            <!-- Applications -->
            <app.redflag.ui.common.HeadingTextView
                style="@style/Widget.Conscience.SettingsSection"
                android:text="@string/settings_section_apps" />

            <LinearLayout
                android:id="@+id/cardApps"
                style="@style/Widget.Conscience.SettingsCard">

                <include
                    android:id="@+id/rowList"
                    layout="@layout/item_setting_row" />

                <View style="@style/Widget.Conscience.SettingsDivider" />

                <include
                    android:id="@+id/rowPermissions"
                    layout="@layout/item_setting_row" />
            </LinearLayout>

            <!-- Debug : visible uniquement dans une version de développement (voir SettingsActivity). -->
            <LinearLayout
                android:id="@+id/debugGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <app.redflag.ui.common.HeadingTextView
                    style="@style/Widget.Conscience.SettingsSection"
                    android:text="@string/settings_section_debug" />

                <LinearLayout
                    android:id="@+id/cardDebug"
                    style="@style/Widget.Conscience.SettingsCard">

                    <include
                        android:id="@+id/rowOnboarding"
                        layout="@layout/item_setting_switch_row" />

                    <View style="@style/Widget.Conscience.SettingsDivider" />

                    <include
                        android:id="@+id/rowReset"
                        layout="@layout/item_setting_row" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
