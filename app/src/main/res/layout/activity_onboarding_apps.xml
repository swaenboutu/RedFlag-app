<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <!-- The issue being handled stays visible while the apps scroll; the explanation and the search scroll away with the list. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="24dp"
        android:paddingEnd="20dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/step"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter_semibold"
            android:includeFontPadding="false"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="13sp" />

        <fr.conscience.numerique.ui.common.HeadingTextView
            android:id="@+id/problem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:fontFamily="@font/bricolage_grotesque"
            android:includeFontPadding="false"
            android:maxLines="3"
            android:textColor="?attr/colorOnSurface"
            android:textSize="22sp"
            android:textStyle="bold" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="16dp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnNext"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="20dp"
        android:enabled="false"
        android:fontFamily="@font/inter_semibold"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:text="@string/onboarding_next"
        android:textSize="17sp"
        app:cornerRadius="28dp" />

    <TextView
        android:id="@+id/btnSkip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:background="?attr/selectableItemBackground"
        android:fontFamily="@font/inter_medium"
        android:gravity="center"
        android:minHeight="48dp"
        android:text="@string/onboarding_skip"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="13.5sp" />
    <TextView
        android:id="@+id/btnSkipRemaining"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:background="?attr/selectableItemBackground"
        android:fontFamily="@font/inter_medium"
        android:gravity="center"
        android:minHeight="48dp"
        android:text="@string/onboarding_skip_remaining"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="13.5sp"
        android:visibility="gone" />
</LinearLayout>
