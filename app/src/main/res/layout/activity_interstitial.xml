<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Cercle décoratif en haut à droite, en partie hors écran. -->
    <View
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:layout_gravity="top|end"
        android:layout_marginEnd="-70dp"
        android:background="@drawable/bg_interstitial_circle"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fitsSystemWindows="true"
        android:orientation="vertical">

        <LinearLayout
            tools:ignore="UseCompoundDrawables"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginTop="32dp"
            android:layout_marginEnd="24dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/appIcon"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_app_icon_rounded"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/appName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="@font/inter_medium"
                android:maxLines="1"
                android:textColor="@color/interstitial_text_muted"
                android:textSize="15sp" />
        </LinearLayout>

        <fr.conscience.numerique.ui.common.HeadingTextView
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="24dp"
            android:fontFamily="@font/bricolage_grotesque_extrabold"
            android:includeFontPadding="false"
            android:text="@string/interstitial_title"
            android:textColor="@color/interstitial_text"
            android:textSize="44sp" />

        <TextView
            android:id="@+id/subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="24dp"
            android:includeFontPadding="false"
            android:textColor="@color/interstitial_text_muted"
            android:textSize="15sp"
            app:lineHeight="22dp" />

        <!-- Liste des problématiques : défile si elle est plus longue que la zone. -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="6dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/problemsList"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginEnd="21dp"
                android:clipToPadding="false"
                android:fadeScrollbars="false"
                android:minHeight="96dp"
                android:overScrollMode="never"
                android:paddingStart="24dp"
                android:paddingTop="8dp"
                android:paddingEnd="19dp"
                android:paddingBottom="18dp"
                android:scrollbarSize="3dp"
                android:scrollbarThumbVertical="@drawable/scrollbar_thumb"
                android:scrollbarTrackVertical="@drawable/scrollbar_track"
                android:scrollbars="vertical"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />
        </FrameLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:background="@color/interstitial_divider"
            android:importantForAccessibility="no" />

        <fr.conscience.numerique.ui.common.HeadingTextView
            android:id="@+id/question"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="24dp"
            android:fontFamily="@font/bricolage_grotesque"
            android:includeFontPadding="false"
            android:text="@string/interstitial_question"
            android:textColor="@color/interstitial_text"
            android:textSize="22sp"
            android:textStyle="bold"
            app:lineHeight="29dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBack"
            style="@style/Widget.Material3.Button"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginStart="20dp"
            android:layout_marginTop="22dp"
            android:layout_marginEnd="20dp"
            android:fontFamily="@font/inter"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/btn_back"
            android:textColor="@color/interstitial_background"
            android:textSize="17sp"
            android:textStyle="bold"
            app:backgroundTint="@color/interstitial_accent"
            app:cornerRadius="28dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnContinue"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginStart="20dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="20dp"
            android:fontFamily="@font/inter_medium"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:textColor="@color/interstitial_text"
            android:textSize="16sp"
            app:cornerRadius="28dp"
            app:strokeColor="@color/interstitial_outline"
            app:strokeWidth="1.5dp" />

        <TextView
            android:id="@+id/btnPause"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="10dp"
            android:background="?attr/selectableItemBackground"
            android:fontFamily="@font/inter_medium"
            android:gravity="center"
            android:minHeight="48dp"
            android:text="@string/btn_pause"
            android:textColor="@color/interstitial_text_subtle"
            android:textSize="13.5sp" />
    </LinearLayout>
</FrameLayout>
