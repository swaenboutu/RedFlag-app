<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

<!-- The horizontal padding lives here: fitsSystemWindows on the root would replace it. -->
<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingEnd="24dp">

    <!-- The app's icon, with the Red Flag planted on its top-right corner. -->
    <FrameLayout
        android:layout_width="120dp"
        android:layout_height="92dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="40dp">

        <ImageView
            android:id="@+id/appIcon"
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:layout_gravity="bottom|center_horizontal"
            android:background="@drawable/bg_interruption_icon"
            android:importantForAccessibility="no" />

        <ImageView
            android:layout_width="28dp"
            android:layout_height="32dp"
            android:layout_gravity="top|end"
            android:layout_marginEnd="1dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_flag" />
    </FrameLayout>

    <app.redflag.ui.common.HeadingTextView
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:fontFamily="@font/bricolage_grotesque_extrabold"
        android:gravity="center"
        android:includeFontPadding="false"
        android:text="@string/interstitial_title"
        android:textStyle="bold"
        android:textColor="@color/interruption_text"
        android:textSize="44sp" />

    <TextView
        android:id="@+id/subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center"
        android:includeFontPadding="false"
        android:textColor="@color/interruption_text_muted"
        android:textSize="17sp"
        app:lineHeight="24dp" />

    <!-- Every issue, separated by dots; the area scrolls if the list is longer than the screen. -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never">

        <TextView
            android:id="@+id/problems"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fontFamily="@font/inter_medium"
            android:gravity="center"
            android:includeFontPadding="false"
            android:paddingTop="16dp"
            android:paddingBottom="16dp"
            android:textColor="@color/interruption_text"
            android:textSize="18sp"
            app:lineHeight="28dp" />
    </ScrollView>

    <app.redflag.ui.common.HeadingTextView
        android:id="@+id/question"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/bricolage_grotesque"
        android:gravity="center"
        android:includeFontPadding="false"
        android:text="@string/interstitial_question"
        android:textColor="@color/interruption_text"
        android:textSize="28sp"
        android:textStyle="bold"
        app:lineHeight="36dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnContinue"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="24dp"
        android:fontFamily="@font/inter_medium"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:text="@string/btn_continue"
        android:textColor="@color/interruption_text"
        android:textSize="17sp"
        app:cornerRadius="28dp"
        app:strokeColor="@color/interruption_outline"
        app:strokeWidth="1.5dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnBack"
        style="@style/Widget.Material3.Button"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="12dp"
        android:fontFamily="@font/inter"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:text="@string/btn_back"
        android:textColor="@color/interruption_background"
        android:textSize="17sp"
        android:textStyle="bold"
        app:backgroundTint="@color/interruption_text"
        app:cornerRadius="28dp" />

    <TextView
        android:id="@+id/btnPause"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="10dp"
        android:background="?attr/selectableItemBackground"
        android:fontFamily="@font/inter_medium"
        android:gravity="center"
        android:minHeight="48dp"
        android:text="@string/btn_pause"
        android:textColor="@color/interruption_text_subtle"
        android:textSize="14sp" />
</LinearLayout>
</FrameLayout>
