<?xml version="1.0" encoding="utf-8"?>
<!--
    Une problématique à cocher. La case est à droite : la mise en page est inversée (layoutDirection=rtl) et le texte
    est ramené à gauche à la main, d'où left/right volontaires. À revoir si une langue de droite à gauche est ajoutée.
    Le fond de carte est posé par l'adaptateur.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/choiceRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp">

    <View
        android:id="@+id/choiceDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginHorizontal="16dp"
        android:background="?attr/colorOutlineVariant"
        android:importantForAccessibility="no" />

    <com.google.android.material.checkbox.MaterialCheckBox
        android:id="@+id/choice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:button="@drawable/sel_check"
        android:fontFamily="@font/inter_medium"
        android:gravity="left|center_vertical"
        android:layoutDirection="rtl"
        android:minHeight="56dp"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:textAlignment="gravity"
        android:textColor="?attr/colorOnSurface"
        android:textDirection="locale"
        android:textSize="15sp"
        app:buttonTint="@null"
        tools:ignore="RtlHardcoded" />
</FrameLayout>
