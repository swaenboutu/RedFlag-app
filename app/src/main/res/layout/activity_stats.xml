<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <fr.conscience.numerique.ui.HeadingTextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="32dp"
        android:layout_marginEnd="20dp"
        android:fontFamily="@font/bricolage_grotesque"
        android:includeFontPadding="false"
        android:text="@string/stats_title"
        android:textColor="?attr/colorOnSurface"
        android:textSize="28sp"
        android:textStyle="bold" />

    <!-- Apps avec une interruption, sur l'ensemble des apps installées. -->
    <LinearLayout
        android:id="@+id/summaryCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/bg_card_white"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/summaryValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/bricolage_grotesque"
            android:includeFontPadding="false"
            android:textColor="?attr/colorOnSurface"
            android:textSize="32sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/summaryCaption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="13sp" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/summaryProgress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:importantForAccessibility="no"
            app:indicatorColor="@color/chart_snoozed"
            app:trackColor="@color/chart_grid"
            app:trackCornerRadius="4dp"
            app:trackStopIndicatorSize="0dp"
            app:trackThickness="8dp" />
    </LinearLayout>

    <fr.conscience.numerique.ui.HeadingTextView
        style="@style/Widget.Conscience.SettingsSection"
        android:text="@string/stats_apps_section" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="8dp"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

        <TextView
            android:id="@+id/emptyState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:gravity="center_horizontal"
            android:padding="24dp"
            android:text="@string/stats_empty"
            android:textAlignment="center"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="14sp"
            android:visibility="gone" />
    </FrameLayout>

    <include
        android:id="@+id/bottomBar"
        layout="@layout/view_bottom_nav" />
</LinearLayout>
