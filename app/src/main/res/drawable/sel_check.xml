<?xml version="1.0" encoding="utf-8"?>
<!-- The box sits on the left of the label; the insets give it room from the card edge and from the text. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <inset
            android:drawable="@drawable/ic_check_on"
            android:insetLeft="16dp"
            android:insetRight="14dp" />
    </item>
    <item>
        <inset
            android:drawable="@drawable/ic_check_off"
            android:insetLeft="16dp"
            android:insetRight="14dp" />
    </item>
</selector>
