<?xml version="1.0" encoding="utf-8"?>
<!-- The bar at the bottom of the welcome tour screens: page color with a thin line on top. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/app_background" />
        </shape>
    </item>
    <item android:height="1dp" android:gravity="top">
        <shape android:shape="rectangle">
            <solid android:color="@color/line" />
        </shape>
    </item>
</layer-list>
