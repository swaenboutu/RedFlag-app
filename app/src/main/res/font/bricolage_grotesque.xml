<?xml version="1.0" encoding="utf-8"?>
<!-- Bricolage Grotesque (police variable) : titres. Le gras (textStyle=bold) utilise l'entrée 700. -->
<font-family xmlns:android="http://schemas.android.com/apk/res/android">
    <font
        android:font="@font/bricolage_grotesque_variable"
        android:fontStyle="normal"
        android:fontVariationSettings="'wght' 400, 'opsz' 24"
        android:fontWeight="400" />
    <font
        android:font="@font/bricolage_grotesque_variable"
        android:fontStyle="normal"
        android:fontVariationSettings="'wght' 700, 'opsz' 24"
        android:fontWeight="700" />
</font-family>
